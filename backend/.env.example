# ==============================================================================
# LEETCODE-NVIDIA-AUTO ENVIRONMENT CONFIGURATION (TEMPLATE)
# Rename this file to '.env' and fill in your API keys. Do NOT upload '.env' to GitHub.
# ==============================================================================

# NVIDIA API Key (Required for Nim models and Llama-based Judge)
# Get your free key at: https://build.nvidia.com/
NVIDIA_API_KEY="your_nvidia_api_key_here"

# OpenRouter API Key (Optional fallback provider for the Judge model)
# Get a key at: https://openrouter.ai/
OPENROUTER_API_KEY="your_openrouter_api_key_here"
